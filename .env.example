# Copy this file to .env and change the values before deploying.
SECRET_KEY=replace-with-a-long-random-string
# Leave DATABASE_URL empty to use SQLite (invest.db in this folder).
# For MySQL (XAMPP / server):  mysql+pymysql://USER:PASSWORD@127.0.0.1/invest
DATABASE_URL=
# 1 = load 30 companies, 30 products, 30 events, 100 investors on first start. 0 = empty database.
SEED_DEMO_DATA=1
